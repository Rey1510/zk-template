<?page title="Template" contentType="text/html;charset=UTF-8"?>
<zk>
    <window border="none" width="100%" height="100%" viewModel="@id('vm')
                       @init('com.rey.template.viewmodel.LayoutVM')">
        <style src="/css/blue-theme.css"/>
        
        <div id="themeDiv" sclass="@load(vm.activeThemeClass)" width="100%" height="100%">
            <borderlayout height="100vh">
                <north size="70px">
                    <include src="/components/header.zul"/>
                </north>
                <west size="240px">
                    <include src="/components/sidebar.zul"/>
                </west>
                <center style="padding: 16px; background: #F5F8FC; box-sizing: border-box;">
                    <include src="@load(vm.currentPage)" vflex="1" hflex="1"/>
                </center>
            </borderlayout>
        </div>
    </window>
</zk>