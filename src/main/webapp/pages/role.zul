<?xml version="1.0" encoding="UTF-8"?>
<window border="none"
        vflex="1"
        hflex="1"
        viewModel="@id('vm')
                   @init('com.rey.template.viewmodel.pages.RoleVM')">

    <style src="/css/report.css"/>

    <vlayout spacing="10px" vflex="1">

        <!-- ======================================================
             HEADER
             ======================================================= -->
        <div sclass="report-header">
            <hlayout valign="middle" style="justify-content:space-between;">
                <vlayout spacing="0px">
                    <label value="Role Management" sclass="report-title"/>
                    <label value="Manage user roles and navigation menu access levels" sclass="report-subtitle"/>
                </vlayout>
            </hlayout>
        </div>

        <!-- ======================================================
             FILTER & TOOLBAR CARD
             ======================================================= -->
        <div sclass="dashboard-card chart-card">
            <hlayout spacing="20px" valign="middle" style="justify-content:space-between; width:100%;">
                <hlayout spacing="10px" valign="middle">
                    <textbox value="@bind(vm.searchKeyword)"
                             placeholder="Search role code or name..."
                             sclass="form-input"
                             width="240px"
                             onOK="@command('search')"/>
                    <button label="Search"
                            sclass="btn-outline"
                            onClick="@command('search')"
                            iconSclass="z-icon-search"/>
                </hlayout>
                <button label="+ Add Role"
                        sclass="btn-primary"
                        onClick="@command('openAdd')"/>
            </hlayout>
        </div>

        <!-- ======================================================
             TABLE CARD
             ======================================================= -->
        <vlayout sclass="dashboard-card table-card" vflex="1" spacing="0px">
            <grid model="@load(vm.pagedRoles)"
                  vflex="1"
                  sclass="modern-grid">

                <columns>
                    <column label="ID"          width="60px"  align="center"/>
                    <column label="ROLE CODE"    width="160px" align="center"/>
                    <column label="ROLE NAME"    width="220px" align="center"/>
                    <column label="ASSIGNED MENUS"             align="center"/>
                    <column label="ACTIONS"     width="140px" align="center"/>
                </columns>

                <template name="model" var="row">
                    <row sclass="grid-row">
                        <label value="@load(row.roleId)"/>
                        <label value="@load(row.roleCode)" sclass="report-name-cell"/>
                        <label value="@load(row.roleName)"/>
                        <label value="@load(row.menusDisplay)" style="font-size: 11px; font-weight: 500; color: #475569;"/>
                        <hlayout spacing="6px" style="justify-content:center;">
                            <button label="Edit"
                                    sclass="btn-sm btn-outline"
                                    onClick="@command('openEdit', dto=row)"/>
                            <button iconSclass="z-icon-trash-o"
                                    sclass="btn-sm btn-danger"
                                    onClick="@command('deleteRole', id=row.roleId)"/>
                        </hlayout>
                    </row>
                </template>

            </grid>

            <!-- Custom Pagination -->
            <hlayout valign="middle" width="100%" style="padding: 10px 14px; border-top: 1px solid #e8edf5; background: #fafbfd; display: flex; align-items: center; border-radius: 0 0 14px 14px;">
                <label value="@load(vm.pagingInfo)" style="font-size: 12px; color: #64748b; font-weight: 500;"/>
                <space hflex="1"/>
                <button label="Prev"
                        sclass="btn-sm btn-outline"
                        disabled="@load(not vm.hasPrev)"
                        onClick="@command('prevPage')"/>
                <label value="@load(vm.currentPageDisplay)" style="font-weight: 600; font-size: 12px; margin: 0 12px; color: #334155;"/>
                <button label="Next"
                        sclass="btn-sm btn-outline"
                        disabled="@load(not vm.hasNext)"
                        onClick="@command('nextPage')"/>
            </hlayout>

        </vlayout>

    </vlayout>

    <!-- ======================================================
         ADD / EDIT MODAL
         ======================================================= -->
    <window visible="@load(vm.showForm)"
            title="@load(vm.formRole.roleId eq null ? 'Add Role' : 'Edit Role')"
            border="normal"
            mode="modal"
            closable="true"
            onClose="event.stopPropagation(); binder.postCommand(&quot;cancelForm&quot;, null);"
            sclass="crud-modal"
            style="width:450px;">

        <vlayout spacing="0px" sclass="modal-body">

            <div sclass="form-group">
                <label value="Role Code" sclass="form-label"/>
                <textbox value="@bind(vm.formRole.roleCode)"
                         placeholder="Enter unique role code (e.g. ADMIN)"
                         sclass="form-input"
                         width="100%"
                         disabled="@load(vm.formRole.roleId ne null)"/>
            </div>

            <div sclass="form-group">
                <label value="Role Name" sclass="form-label"/>
                <textbox value="@bind(vm.formRole.roleName)"
                         placeholder="Enter role display name"
                         sclass="form-input"
                         width="100%"/>
            </div>

            <div sclass="form-group">
                <label value="Assign Navigation Menus" sclass="form-label"/>
                <vlayout spacing="8px" style="padding: 4px 0; max-height: 200px; overflow-y: auto;" children="@load(vm.availableMenus)">
                    <template name="children" var="menu">
                        <checkbox label="@load(menu.menuName.concat(' (').concat(menu.menuCode).concat(')'))"
                                  checked="@load(vm.hasMenu(menu.menuCode))"
                                  onCheck="@command('toggleMenu', menu=menu.menuCode)" />
                    </template>
                </vlayout>
            </div>

            <separator/>

            <hlayout spacing="10px" style="justify-content:flex-end;padding-top:8px;">
                <button label="Cancel"
                        sclass="btn-outline"
                        onClick="@command('cancelForm')"/>
                <button label="Save Role"
                        sclass="btn-primary"
                        onClick="@command('saveRole')"/>
            </hlayout>

        </vlayout>

    </window>

</window>
