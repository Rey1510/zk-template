<?xml version="1.0" encoding="UTF-8"?>
<window border="none"
        vflex="1"
        hflex="1"
        viewModel="@id('vm')
                   @init('com.rey.template.viewmodel.pages.MenuVM')">

    <style src="/css/report.css"/>

    <vlayout spacing="10px" vflex="1">

        <!-- ======================================================
             HEADER
             ======================================================= -->
        <div sclass="report-header">
            <hlayout valign="middle" style="justify-content:space-between;">
                <vlayout spacing="0px">
                    <label value="Menu Management" sclass="report-title"/>
                    <label value="Configure navigation menus, ordering, and routes" sclass="report-subtitle"/>
                </vlayout>
            </hlayout>
        </div>

        <!-- ======================================================
             FILTER & TOOLBAR CARD
             ======================================================= -->
        <div sclass="dashboard-card chart-card">
            <hlayout spacing="20px" valign="middle" style="justify-content:space-between; width:100%;">
                <hlayout spacing="10px" valign="middle">
                    <textbox value="@bind(vm.searchKeyword)"
                             placeholder="Search code, name, or path..."
                             sclass="form-input"
                             width="220px"
                             onOK="@command('search')"/>
                    <button label="Search"
                            sclass="btn-outline"
                            onClick="@command('search')"
                            iconSclass="z-icon-search"/>
                </hlayout>
                <button label="+ Add Menu"
                        sclass="btn-primary"
                        onClick="@command('openAdd')"/>
            </hlayout>
        </div>

        <!-- ======================================================
             TABLE CARD
             ======================================================= -->
        <vlayout sclass="dashboard-card table-card" vflex="1" spacing="0px">
            <grid model="@load(vm.pagedMenus)"
                  vflex="1"
                  sclass="modern-grid">

                <columns>
                    <column label="ID"          width="60px"  align="center"/>
                    <column label="MENU CODE"    width="140px" align="center"/>
                    <column label="MENU NAME"    width="200px" align="center"/>
                    <column label="ZUL PATH"                   align="center"/>
                    <column label="ORDER"       width="80px"  align="center"/>
                    <column label="STATUS"      width="110px" align="center"/>
                    <column label="ACTIONS"     width="140px" align="center"/>
                </columns>

                <template name="model" var="row">
                    <row sclass="grid-row">
                        <label value="@load(row.menuId)"/>
                        <label value="@load(row.menuCode)" sclass="report-name-cell"/>
                        <label value="@load(row.menuName)"/>
                        <label value="@load(row.zulPath)"/>
                        <label value="@load(row.menuOrder)"/>
                        <div style="text-align:center;">
                            <span sclass="@load(row.active ? 'status-badge badge-success' : 'status-badge badge-failed')">
                                <span sclass="@load(row.active ? 'z-icon-check' : 'z-icon-times')"/>
                                <label value="@load(row.active ? 'ACTIVE' : 'INACTIVE')"/>
                            </span>
                        </div>
                        <hlayout spacing="6px" style="justify-content:center;">
                            <button label="Edit"
                                    sclass="btn-sm btn-outline"
                                    onClick="@command('openEdit', dto=row)"/>
                            <button iconSclass="z-icon-trash-o"
                                    sclass="btn-sm btn-danger"
                                    onClick="@command('deleteMenu', id=row.menuId)"/>
                        </hlayout>
                    </row>
                </template>

            </grid>

            <!-- Custom Pagination -->
            <hlayout valign="middle" width="100%" style="padding: 10px 14px; border-top: 1px solid #e8edf5; background: #fafbfd; display: flex; align-items: center; border-radius: 0 0 14px 14px;">
                <label value="@load(vm.pagingInfo)" style="font-size: 12px; color: #64748b; font-weight: 500;"/>
                <space hflex="1"/>
                <button label="Prev"
                        sclass="btn-sm btn-outline"
                        disabled="@load(not vm.hasPrev)"
                        onClick="@command('prevPage')"/>
                <label value="@load(vm.currentPageDisplay)" style="font-weight: 600; font-size: 12px; margin: 0 12px; color: #334155;"/>
                <button label="Next"
                        sclass="btn-sm btn-outline"
                        disabled="@load(not vm.hasNext)"
                        onClick="@command('nextPage')"/>
            </hlayout>

        </vlayout>

    </vlayout>

    <!-- ======================================================
         ADD / EDIT MODAL
         ======================================================= -->
    <window visible="@load(vm.showForm)"
            title="@load(vm.formMenu.menuId eq null ? 'Add Menu' : 'Edit Menu')"
            border="normal"
            mode="modal"
            closable="true"
            onClose="event.stopPropagation(); binder.postCommand(&quot;cancelForm&quot;, null);"
            sclass="crud-modal"
            style="width:450px;">

        <vlayout spacing="0px" sclass="modal-body">

            <div sclass="form-group">
                <label value="Menu Code" sclass="form-label"/>
                <textbox value="@bind(vm.formMenu.menuCode)"
                         placeholder="Enter unique menu code (e.g. MENU_USER)"
                         sclass="form-input"
                         width="100%"
                         disabled="@load(vm.formMenu.menuId ne null)"/>
            </div>

            <div sclass="form-group">
                <label value="Menu Name" sclass="form-label"/>
                <textbox value="@bind(vm.formMenu.menuName)"
                         placeholder="Enter menu display name"
                         sclass="form-input"
                         width="100%"/>
            </div>

            <div sclass="form-group">
                <label value="ZUL Path" sclass="form-label"/>
                <textbox value="@bind(vm.formMenu.zulPath)"
                         placeholder="Enter page ZUL path (e.g. /pages/user.zul)"
                         sclass="form-input"
                         width="100%"/>
            </div>

            <div sclass="form-group">
                <label value="Menu Order" sclass="form-label"/>
                <intbox value="@bind(vm.formMenu.menuOrder)"
                        placeholder="Enter display order number"
                        sclass="form-input"
                        width="100%"/>
            </div>

            <div sclass="form-group">
                <hlayout valign="middle" spacing="8px">
                    <checkbox checked="@bind(vm.formMenu.active)"/>
                    <label value="Menu Active" sclass="form-label" style="margin-bottom:0; cursor:pointer;"/>
                </hlayout>
            </div>

            <separator/>

            <hlayout spacing="10px" style="justify-content:flex-end;padding-top:8px;">
                <button label="Cancel"
                        sclass="btn-outline"
                        onClick="@command('cancelForm')"/>
                <button label="Save Menu"
                        sclass="btn-primary"
                        onClick="@command('saveMenu')"/>
            </hlayout>

        </vlayout>

    </window>

</window>
