<zk>

    <vlayout
            hflex="1"
            spacing="20px"
            style="padding:30px;">

        <!-- Welcome Section -->
        <vlayout
                sclass="welcome-card">

            <label
                    value="Welcome to Customer Apps"
                    style="
                        font-size:28px;
                        font-weight:bold;
                        color:#0054A6;"/>

            <label
                    value="Building digital solutions to support customer-facing services and business operations."
                    style="
                        font-size:14px;
                        color:#666666;"/>

        </vlayout>

        <!-- Feature Cards -->
        <hlayout spacing="20px">

            <vlayout
                    width="300px"
                    sclass="feature-card">

                <label
                        value="📱 Customer Services"
                        style="font-size:18px;font-weight:bold;"/>

                <label
                        value="Provide seamless applications and services for customers and partners."/>

            </vlayout>

            <vlayout
                    width="300px"
                    sclass="feature-card">

                <label
                        value="⚡ Business Efficiency"
                        style="font-size:18px;font-weight:bold;"/>

                <label
                        value="Accelerate operational processes through digital transformation."/>

            </vlayout>

            <vlayout
                    width="300px"
                    sclass="feature-card">

                <label
                        value="🔒 Secure and Reliable"
                        style="font-size:18px;font-weight:bold;"/>

                <label
                        value="Enterprise-grade security and governance for business applications."/>

            </vlayout>

        </hlayout>

        <!-- Quote -->
        <vlayout
                style="
                    margin-top:20px;
                    padding:20px;
                    border-left:4px solid #0054A6;
                    background:#F7FAFF;">

            <label
                    value="Empowering business through customer-centric digital innovation."
                    style="
                        font-size:16px;
                        font-style:italic;
                        color:#0054A6;"/>

        </vlayout>

    </vlayout>

</zk>